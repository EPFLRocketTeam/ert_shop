# Root env for docker-compose / Dokploy. Copy to .env - NEVER commit .env.

# Set these BEFORE the first `docker compose up`: Postgres only reads them when it
# initialises an empty volume. Password: letters/digits only, e.g.
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
POSTGRES_USER=medusa
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ert_shop

# openssl rand -hex 32
JWT_SECRET=change-me
COOKIE_SECRET=change-me

# Production example:
#   STORE_CORS=https://shop.epflrocketteam.ch
#   ADMIN_CORS=https://api.shop.epflrocketteam.ch
#   AUTH_CORS=https://api.shop.epflrocketteam.ch
#   MEDUSA_BACKEND_URL=https://api.shop.epflrocketteam.ch
#   NEXT_PUBLIC_BASE_URL=https://shop.epflrocketteam.ch
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:9000
MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_BASE_URL=http://localhost:8000

# Stripe (ERT account). Start with TEST keys: sk_test_... / pk_test_...
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_KEY=

# Leave empty: with docker compose the backend creates it on first start and
# hands it to the storefront automatically. Only set it to override.
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=

# Optional: first admin dashboard user, created automatically on start
MEDUSA_ADMIN_EMAIL=
MEDUSA_ADMIN_PASSWORD=

REVALIDATE_SECRET=change-me
