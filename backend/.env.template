# ---- Copy to .env for local development (never commit .env) ----

# Postgres connection. With docker-compose this is set for you.
DATABASE_URL=postgres://medusa:medusa@localhost:5432/ert_shop
REDIS_URL=redis://localhost:6379

# CORS: storefront origin / admin origins (comma-separated)
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:5173,http://localhost:9000
AUTH_CORS=http://localhost:5173,http://localhost:9000

# Generate real values for production: openssl rand -hex 32
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret

# Public URL of this backend (used by the admin dashboard)
MEDUSA_BACKEND_URL=http://localhost:9000

# shared (local) | server | worker (production, two containers)
MEDUSA_WORKER_MODE=shared
DISABLE_MEDUSA_ADMIN=false

# ---- Stripe (ERT account) ----
# Use the TEST keys (sk_test_...) until the end-to-end flow is verified.
# Leave empty to run without Stripe (orders then use the manual provider).
STRIPE_API_KEY=
# From Stripe Dashboard -> Developers -> Webhooks, endpoint:
#   https://<backend-domain>/hooks/payment/stripe_stripe
STRIPE_WEBHOOK_SECRET=
